<?xml version="1.0" encoding="utf-8"?>
<!--
   Belt-and-suspenders backup exclusions (audit I-13). allowBackup is already "false" in the
   manifest; these rules additionally exclude every app-data domain so that a future file,
   preference, or database placed outside noBackupFilesDir can never become backup-eligible by
   accident. Bridge credentials and routing metadata live under noBackupFilesDir and are never
   eligible regardless of these rules.
   Note: this file is ignored for devices older than API 31; see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
