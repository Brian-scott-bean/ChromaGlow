# =========================
# Xcode / Swift
# =========================
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate
*.xcscmblueprint
.xcode.env.local

# =========================
# Swift Package Manager
# =========================
.build/
.swiftpm/
# Package.resolved is committed so both developers use the same package versions.

# =========================
# IDEs: Cursor & VS Code
# =========================
.vscode/
*.code-workspace
.history/

# Cursor local/session state only — shared rules and skills stay in repo
.cursor/*
!.cursor/rules/
!.cursor/skills/

# =========================
# macOS
# =========================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# =========================
# CocoaPods (if added later)
# =========================
Pods/
# Podfile.lock is committed when using CocoaPods (same rationale as Package.resolved).
# Do not add *.xcworkspace here — it would ignore HueHome.xcodeproj/project.xcworkspace.

# =========================
# Carthage (not used)
# =========================
Carthage/Build/

# =========================
# Xcode Previews / Instruments
# =========================
PreviewReplacement*/
*.trace

# =========================
# Fastlane (for future deployments)
# =========================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# =========================
# Sensitive / local-only
# =========================
*.p12
*.mobileprovision
secrets.xcconfig
